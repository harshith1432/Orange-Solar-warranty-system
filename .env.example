# ==============================================================================
# Orange Solar E-Warranty Platform Environment Configuration Template
# Copy this file to .env and configure your local environment credentials
# ==============================================================================

# Administrator Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Spring Boot Datasource Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orange
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# Application Ports & URLs
SERVER_PORT=8085
APP_FRONTEND_URL=http://localhost:5173
